class":"data row12 col1","children":[{"type":"text","value":"2.79","key":"DMlNme8uZF"}],"html_id":"t-59f24-row12-col1","key":"axUGHgenuM"},{"type":"tableCell","identifier":"t_59f24_row12_col2","label":"T_59f24_row12_col2","class":"data row12 col2","children":[{"type":"text","value":"0.091 [0.056, 0.13]","key":"h9NBluc60P"}],"html_id":"t-59f24-row12-col2","key":"GtMDUwaZGv"},{"type":"tableCell","identifier":"t_59f24_row12_col3","label":"T_59f24_row12_col3","class":"data row12 col3","children":[{"type":"text","value":"0.255 [0.153, 0.359]","key":"aNAlzh78YF"}],"html_id":"t-59f24-row12-col3","key":"M145DDbnId"}],"key":"YtarqnnGXf"}],"enumerator":"1","html_id":"t-59f24","key":"ukCCVQqeFr"}],"key":"dQBheXIevG"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"The predictor with the highest coefficient, road traffic, has a relatively low standard deviation, so its importance is only moderate (6th out of 13).","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"HKRRwxNu8H"}],"key":"LfShiu3ADt"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"The predictor with the highest importance is cancer, because it has the highest standard deviation and a moderate coefficient.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"sXG4KtEsLM"}],"key":"CahHDfpa0e"},{"type":"paragraph","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"The predictor with the lowest importance is drug disorders, because it has a small coefficient and a small standard deviation.","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"F6Kkxd8e3d"}],"key":"n4n0ujmvBe"},{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"The following figure shows the results graphically.","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"AGNsWzwH4B"}],"key":"xs96GRdKmI"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/LifeExpectancy//build/blog2_importance_le-a1192b685501166488fb6632ce6d09c5.png","alt":"Predictor importance for life expectancy gender gap (2000–2023).","width":"80%","data":{"altTextIsAutoGenerated":true},"key":"PJ5hZJAjkw","urlSource":"figs/blog2_importance_le.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"Predictor importance for life expectancy gender gap (2000–2023).","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"znDeMYG4e4"}],"key":"mhH5UYQcCv"}],"key":"iuNyWYDFjq"}],"enumerator":"3","key":"DWzaDjUxIs"},{"type":"paragraph","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"These importances direct our attention to the causes that contribute most strongly to variation in life expectancy gap:","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"qPsAJXpcLX"}],"key":"QqRS1nuHWD"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":105,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":105,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"The top three are cancer, cardiovascular disease, and homicide.","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"dAVUWQDpTC"}],"key":"C3xhev7cou"}],"key":"X1lnJWsjYk"},{"type":"listItem","spread":true,"position":{"start":{"line":107,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"Suicide, respiratory disease, traffic, liver disease, and injury have moderate importance.","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"U9KW4QWlQC"}],"key":"DzyLePzXKP"}],"key":"zrVtH7Tw29"},{"type":"listItem","spread":true,"position":{"start":{"line":109,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"COVID-19, childhood mortality, alcohol, diabetes, and drug disorders have lower importance.","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"qcAGIVFTbA"}],"key":"yvsXH3nRiZ"}],"key":"eLWXAvJzFx"}],"key":"T8SpjO9GxO"},{"type":"paragraph","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"children":[{"type":"text","value":"However, we should not ignore factors with lower importance.","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"gayceorEZa"}],"key":"EfA04tRfoQ"},{"type":"paragraph","position":{"start":{"line":113,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"text","value":"First, the most important factor overall might not be the most important factor for a particular country.\nFor example, drug disorders have a much larger effect on life expectancy in the United States and Canada, compared to other OECD countries.\nAnd the importance of COVID-19 is attenuated because it only affected 3 out of 24 years in the panel.","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"GlYZA1LFV9"}],"key":"UUV8kcmoA5"},{"type":"paragraph","position":{"start":{"line":117,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"Also, some factors are easier to change than others.\nWe might focus on a factor with only moderate importance, if we think it is more amenable to change than another factor with higher importance.","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"HDS8Updxjf"}],"key":"sZPbcUtJnN"},{"type":"paragraph","position":{"start":{"line":120,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"In the next post, we will look more closely at the United States to see which factors contribute most to the life expectancy gap.\nAnd we will consider which ones might be most amenable to change.","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"tKUpmSPs8Q"}],"key":"leNVoGetBW"},{"type":"heading","depth":2,"position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"text","value":"Model Details","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"Zxw8JDKvv3"}],"identifier":"model-details","label":"Model Details","html_id":"model-details","implicit":true,"key":"qPQdqRAYAL"},{"type":"paragraph","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"The model uses panel data from 2000–2023 with 888 observations across 24 years and 37 OECD countries.","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"d55TZOkgl8"}],"key":"gU40i2rMQv"},{"type":"paragraph","position":{"start":{"line":128,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"The model is Bayesian hierarchical regression with per-country intercepts and shared slopes.\nPredictors are standardized (z-scores); the target (life expectancy gap) is centered.","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"mjbqhD6Kg8"}],"key":"Y8iuFzN3zK"},{"type":"paragraph","position":{"start":{"line":131,"column":1},"end":{"line":132,"column":1}},"children":[{"type":"text","value":"The model fits the data well; mean absolute error is about 0.2 years.\nThe following figure shows residuals — the difference between actual and predicted gaps — for all 37 countries, sorted with the best-fitting countries at the top.","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"j6ZTm8Xv8H"}],"key":"t0irw0YPjP"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/LifeExpectancy//build/blog2_residuals_by_c-70707101b660c787a32f07b1b2305c9e.png","alt":"Model residuals by country (sorted by IQR, best fit at top).\nSource: Bayesian hierarchical panel model. IHME cause-specific mortality, OWID Life Expectancy.","width":"80%","data":{"altTextIsAutoGenerated":true},"key":"P1feJ7igJ8","urlSource":"figs/blog2_residuals_by_country_le.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":137,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"Model residuals by country (sorted by IQR, best fit at top).\nSource: Bayesian hierarchical panel model. IHME cause-specific mortality, OWID Life Expectancy.","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"IjPOFdSspP"}],"key":"sRuuHHbtAV"}],"key":"owhsNAx6mm"}],"enumerator":"4","key":"zCNprgKLcI"},{"type":"paragraph","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"The model fits some countries better than others, but even when the magnitude of the residuals is larger, they are generally centered around zero and symmetric.","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"MTznEftL9n"}],"key":"t2OkJvXOZf"},{"type":"paragraph","position":{"start":{"line":143,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"To show what the quality of fit looks like, the following figure shows predicted versus actual gaps for selected countries: the United States, with the best fit, Iceland and Lithuania, with some of the worst, and France, which is near the middle.\nThe colored lines show actual values; the gray vertical segments show 94% credible intervals for the fitted values.","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"LOjlY0CDQx"}],"key":"RUKLEdT1X8"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/LifeExpectancy//build/blog2_residuals_time-24a0714497fd53767fea5332c245fa3b.png","alt":"Predicted vs actual life expectancy gap (2000–2023), selected countries.\nSource: Bayesian hierarchical panel model. IHME cause-specific mortality, OWID Life Expectancy.","width":"80%","data":{"altTextIsAutoGenerated":true},"key":"HQISjjI1Lz","urlSource":"figs/blog2_residuals_timeseries_le.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":149,"column":1},"end":{"line":150,"column":1}},"children":[{"type":"text","value":"Predicted vs actual life expectancy gap (2000–2023), selected countries.\nSource: Bayesian hierarchical panel model. IHME cause-specific mortality, OWID Life Expectancy.","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"T5XSxcLtjn"}],"key":"CPFoQOdUNJ"}],"key":"PJpy8Qo61f"}],"enumerator":"5","key":"EMFdb4Cwe0"},{"type":"paragraph","position":{"start":{"line":153,"column":1},"end":{"line":155,"column":1}},"children":[{"type":"text","value":"In the United States, the model tracks the observed gaps closely, including the COVID period and the opioid-driven increase.\nIn Iceland and Lithuania, there are some large changes in the life expectancy gap that are not explained by changes in death rate gaps.\nSmall countries might vary more over time (the United States is almost 1000 times more populous than Iceland and over 100 times more populous than Lithuania).","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"eQeo1fMH6O"}],"key":"dkvX1S56bD"},{"type":"heading","depth":3,"position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"children":[{"type":"text","value":"Variations","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"key":"B0iLxX8NwH"}],"identifier":"variations","label":"Variations","html_id":"variations","implicit":true,"key":"vIB1xetvYq"},{"type":"paragraph","position":{"start":{"line":159,"column":1},"end":{"line":162,"column":1}},"children":[{"type":"text","value":"In addition to the 13 predictors in the model we reported, we also considered two other factors: maternal disorders and conflict/terrorism.\nIn both cases, the estimated coefficients were small, with credible intervals that spanned zero, and the change in model fit was negligible.\nFor both predictors, variability is small — combined with small coefficients, the resulting importances are negligible.\nSo we removed both predictors from the model.","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"XUD8gb7exv"}],"key":"C5LHWU2uOT"},{"type":"paragraph","position":{"start":{"line":164,"column":1},"end":{"line":165,"column":1}},"children":[{"type":"text","value":"We exclude Turkey because when included, it appears as a statistical outlier.\nTurkey differs from other OECD countries in several ways — it is also possible that some of its statistics are less reliable.","position":{"start":{"line":164,"column":1},"end":{"line":164,"column":1}},"key":"o6ZoP8X0CW"}],"key":"g5nPQNimbc"},{"type":"paragraph","position":{"start":{"line":167,"column":1},"end":{"line":169,"column":1}},"children":[{"type":"text","value":"As an extension to the model, we considered including death rates as well as gaps.\nThese additional predictors improve the model fit only moderately, as they are highly correlated with the gaps — when death rates are higher, the gaps are usually higher.\nSo adding them to the model only complicates the interpretation of the coefficients, as the effect of each cause is distributed unpredictably between the rate and the gap.","position":{"start":{"line":167,"column":1},"end":{"line":167,"column":1}},"key":"HdPbviMvtq"}],"key":"gEmgvvpVLC"},{"type":"paragraph","position":{"start":{"line":171,"column":1},"end":{"line":172,"column":1}},"children":[{"type":"text","value":"Finally, we tested a version of the model with a Gaussian Random Walk intended to capture shared temporal trends.\nBut it complicates the model without improving fit, so we removed it for parsimony.","position":{"start":{"line":171,"column":1},"end":{"line":171,"column":1}},"key":"xvzIaVVxSq"}],"key":"FpjcLAtwdK"},{"type":"thematicBreak","position":{"start":{"line":174,"column":1},"end":{"line":174,"column":1}},"key":"rE9f7UKcWB"},{"type":"paragraph","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"children":[{"type":"text","value":"Next: [Counterfactuals: How much of the gap could we close?]","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"key":"kXx3cmSWoK"}],"key":"AMOyLpQnsR"}],"key":"v0HTo2Sk1g"}],"key":"gDmoxPGobn"}],"key":"mz6kguVS9e"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"The Gender Gap in Life Expectancy","short_title":"Blog Post 1: Time Series Analysis","url":"/blog1-time-series","group":"Gender Gaps in Life Expectancy"},"next":{"title":"How Much of the Life Expectancy Gap Could We Close?","short_title":"Blog Post 3: Counterfactuals","url":"/blog3-counterfactual","group":"Gender Gaps in Life Expectancy"}}},"domain":"http://localhost:3025"}