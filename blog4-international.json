read":true,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"South Korea","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"wbOFNKigg2"}],"key":"OGEX5ZBw4z"},{"type":"text","value":" (6.78 years): Cancer (-0.80), Suicide (-0.75)","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"z7dVIoAAMM"}],"key":"FYyywAvGnH"}],"key":"exa6LLrnbu"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"Israel","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"kFkrmKFRfS"}],"key":"eykuCMTdo9"},{"type":"text","value":" (3.69 years): Road Traffic (-0.18), Cancer (-0.17), Suicide (-0.11)","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"ksyK0pREkH"}],"key":"A1KZhdLDai"}],"key":"wf1Zgf8Rge"}],"key":"OaXdaZegOy"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"Nine of the thirteen factors in the model appear as a leading factor in at least one country.\nOnly four did not: unintentional injury, COVID-19, childhood mortality, and diabetes — although COVID was a leading factor in some countries during the peak of the pandemic.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"xoIeVanxRE"}],"key":"DVBb7Akbpm"},{"type":"heading","depth":2,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Success Story: Road Traffic in Europe","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"x7QgPColiW"}],"identifier":"success-story-road-traffic-in-europe","label":"Success Story: Road Traffic in Europe","html_id":"success-story-road-traffic-in-europe","implicit":true,"key":"TUxEhVgX9S"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Road traffic is a leading factor in only four countries in the European Union (EU), and it is not the top factor in any.\nThat might not be a coincidence: In the early 2000s, the EU launched a coordinated effort to reduce traffic fatalities.\nA 2001 transport policy set the goal of cutting road deaths in half by 2010, and the European Road Safety Action Programme (2003–2010) promoted stronger enforcement of speeding and drunk-driving laws, expanded seatbelt use, safer road design, and improved vehicle safety standards.\nA follow-on program (2011–2020) added focus on safer infrastructure, protection for pedestrians and cyclists, and vehicle features like automatic emergency braking and lane-departure warnings.","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"TgIkAhIUQ2"}],"key":"wpE91afMyo"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"These policies were not targeted specifically to men, but because traffic death rates are higher for men, the reduction in their rates was larger.\nAs a result, in every European country the contribution of traffic deaths to the life expectancy gap declined between 2000 and 2023.\nThe following figure shows these changes.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"lvmn7k51PN"}],"key":"Yiyml0aaPM"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/LifeExpectancy//build/road_traffic_dumbbel-a2a17f612badee5fab367396c95c971d.png","alt":"Change in road traffic contribution to the life expectancy gender gap (2000–2023), European OECD countries.","data":{"altTextIsAutoGenerated":true},"key":"WnrYO3J1iC","urlSource":"figs/road_traffic_dumbbell_europe.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"road-traffic-dumbbell","identifier":"road-traffic-dumbbell","html_id":"road-traffic-dumbbell","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"p86dsdNqbQ"},{"type":"text","value":"1","key":"b6klrKbAWa"},{"type":"text","value":":","key":"VGMJqvL0fT"}],"template":"Figure %s:","key":"xcVMrsEkU8"},{"type":"text","value":"Change in road traffic contribution to the life expectancy gender gap (2000–2023), European OECD countries.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"tFnfpKR1Yl"}],"key":"KDx784BkDG"}],"key":"D4vth9EN35"}],"label":"road-traffic-dumbbell","identifier":"road-traffic-dumbbell","enumerator":"1","html_id":"road-traffic-dumbbell","key":"NTKvBzGRvw"},{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"The changes are largest in Eastern and Southern Europe, where traffic death rates were highest.\nIn five countries the life expectancy gap due to traffic decreased by more than a year.\nIn another eleven countries, it decreased by more than 0.5 years.\nAnd in six countries, the remaining contribution is less than 0.1 years — which shows that it is possible to eliminate the gender gap in road traffic deaths.","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"vv0l6hAIkc"}],"key":"q4hzzadj1E"},{"type":"heading","depth":2,"position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"Amenable to Change","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"UAUQjUXIzp"}],"identifier":"amenable-to-change","label":"Amenable to Change","html_id":"amenable-to-change","implicit":true,"key":"xAIOYyzPan"},{"type":"paragraph","position":{"start":{"line":101,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"Road traffic in Europe is an example of how public health and safety policies can reduce the life expectancy gap.\nIt is likely that the other causes of death that contribute to the gap are also amenable to intervention.","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"UT04tN2yRB"}],"key":"ATR1qTwCiq"},{"type":"paragraph","position":{"start":{"line":104,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"strong","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Drug disorders","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"pYAhl28IaL"}],"key":"HIeZfKqwue"},{"type":"text","value":": The opioid epidemic in the United States and Canada was avoidable.\nOther high-income countries avoided harms on the same scale by maintaining stricter controls on opioid prescribing, implementing prescription monitoring systems earlier, limiting pharmaceutical marketing, and expanding harm-reduction measures.\nDeaths due to drug disorders have started to decline in the United States and Canada (although the causes are not yet clear).\nIf these trends continue, we expect this component of the life expectancy gap to decrease.","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"flyYqvgyqa"}],"key":"xuulCje9oj"},{"type":"paragraph","position":{"start":{"line":109,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"strong","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"Alcohol","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"mVPbaoAqST"}],"key":"oOPZRjRUSS"},{"type":"text","value":": The Baltic countries and Poland implemented alcohol control policies — including tax increases, availability restrictions, and marketing limits — that reduced alcohol-attributable mortality and contributed to declines in liver disease and suicide.\nIn general, a decrease in alcohol use directly reduces the contribution of alcohol-related mortality and indirectly reduces the contributions of homicide, suicide, road traffic, liver disease, and cancer.\nIn many OECD countries, ","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"Ra6BnNZXyZ"},{"type":"link","url":"https://www.oecd.org/en/publications/2025/11/health-at-a-glance-2025_a894f72e/full-report/alcohol-consumption_f009f222.html","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"alcohol use is falling","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"FGus1A1Z3Y"}],"urlSource":"https://www.oecd.org/en/publications/2025/11/health-at-a-glance-2025_a894f72e/full-report/alcohol-consumption_f009f222.html","key":"JwFjZ4MYiK"},{"type":"text","value":", with lower rates of drinking among recent cohorts, compared with previous generations.\nIf these patterns persist, alcohol’s contribution to the life expectancy gap may decrease as well.","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"itdHmWePeJ"}],"key":"Nt2AZCl5AT"},{"type":"paragraph","position":{"start":{"line":114,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"strong","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Smoking","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"FotMJMAmJu"}],"key":"QkXG52sXQI"},{"type":"text","value":": ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"t9sIyHUW4C"},{"type":"link","url":"https://www.oecd.org/en/publications/health-at-a-glance-2025_8f9e3f98-en/full-report/smoking-and-vaping_23b355e4.html","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Smoking rates have declined in most OECD countries","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"B638d1VsgF"}],"urlSource":"https://www.oecd.org/en/publications/health-at-a-glance-2025_8f9e3f98-en/full-report/smoking-and-vaping_23b355e4.html","key":"QAnDORYOIV"},{"type":"text","value":", driven by higher taxes, smoke-free laws, advertising bans, graphic health warnings on packaging, and restrictions on sales to minors.\nBecause smoking contributes to lung disease, cardiovascular disease, and several cancers, these declines are expected to reduce smoking-related mortality over time.\nBecause more men smoke, falling rates have already contributed to reductions in the life expectancy gap in many countries.","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"QYMatJ9BGc"}],"key":"AWIvUK5zxi"},{"type":"paragraph","position":{"start":{"line":118,"column":1},"end":{"line":120,"column":1}},"children":[{"type":"strong","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"Cancer","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"VRizKGpa5b"}],"key":"lqtE69Rsr2"},{"type":"text","value":": According to ","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"k4KVL4pccv"},{"type":"link","url":"https://www.nature.com/articles/s41591-026-04219-7","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"this recent study across 185 countries","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"MykXShfjRT"}],"urlSource":"https://www.nature.com/articles/s41591-026-04219-7","key":"gyu51JvAr1"},{"type":"text","value":" almost 40% of new cancers are preventable, attributable to factors including smoking and alcohol, obesity and lack of exercise, air pollution, solar radiation, infection, and occupational exposure.\nLike smoking and alcohol use, many of these factors are amenable to public health and safety policies.\nThe paper notes that the proportion of preventable cancers is higher in men, which suggests that interventions that reduce death rates due to cancer would have a larger effect on men and reduce the life expectancy gap.","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"M42hcjsdUs"}],"key":"PS17fqNX9t"},{"type":"paragraph","position":{"start":{"line":122,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"strong","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"text","value":"Suicide","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"NNBts7mua2"}],"key":"rYR9SRUGWp"},{"type":"text","value":": In most OECD countries, the contribution of suicide to the life expectancy gap decreased between 2000 and 2023.\nThe biggest declines were in the Baltic and Central European countries, due to improving economic conditions after the post-Soviet transition, stronger alcohol control policies, and the adoption of national suicide-prevention strategies.\nSimilar declines occurred in Finland, Ireland, and Japan following coordinated public health interventions.","position":{"start":{"line":122,"column":1},"end":{"line":122,"column":1}},"key":"rZZ9iIHtNy"}],"key":"nezYc0Lqqd"},{"type":"paragraph","position":{"start":{"line":126,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"The contribution of suicide increased by 0.11–0.14 years in the United States, Mexico, and Costa Rica, and by 0.34 years in South Korea.\nIn the United States, rising suicide mortality has been concentrated among middle-aged men in economically declining regions; it is associated with job loss, substance abuse, social isolation, and uneven access to mental-health care.\nIn South Korea, suicide rates rose sharply after the Asian financial crisis of the late 1990s and have remained high; it has been attributed to economic insecurity, workplace and educational pressures, and population aging, along with limited mental-health services and stigma surrounding treatment.","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"ygQ8upZJ20"}],"key":"upvyxkPyIi"},{"type":"paragraph","position":{"start":{"line":130,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"strong","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"text","value":"Homicide","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"xwqUylByOp"}],"key":"L143TQDhlZ"},{"type":"text","value":": In most OECD countries homicide contributes less than 0.05 years to the life expectancy gap, and changes since 2000 are small.\nThe largest decline was in Colombia, where the contribution fell from 4.17 years to 1.61 years, due to state security policies, the demobilization of paramilitary groups, reduction of armed conflict, and violence-prevention efforts in major cities.\nIn Estonia, Latvia, and Lithuania the contribution decreased by 0.25–0.52 years as economic conditions stabilized and institutions strengthened after the post-Soviet transition.\nThe contribution of homicide increased by 0.3 years in Costa Rica and 0.7 years in Mexico due to increasing violence associated with organized crime and drug trafficking.","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"pm2Ku6wISO"}],"key":"IJC8t81Lvm"},{"type":"paragraph","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"text","value":"These examples show that the leading causes of the life expectancy gap are contingent: they depend on economic and social conditions, and they are amenable to the effect of public health and safety policies.","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"nNDAAJlyEH"}],"key":"pqdhgQoQEB"},{"type":"heading","depth":2,"position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Technical Note: Country-specific intercepts","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"nC9nhPeg4k"}],"identifier":"technical-note-country-specific-intercepts","label":"Technical Note: Country-specific intercepts","html_id":"technical-note-country-specific-intercepts","implicit":true,"key":"AQnBygWAwl"},{"type":"paragraph","position":{"start":{"line":139,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"For each country, the model includes an intercept that captures the part of the observed life expectancy gap that is not explained by the gaps in death rates, but is consistent over time.\nThe following figure shows these country-specific intercepts, sorted from highest to lowest.\nError bars show 94% credible intervals.","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"NU7yQN41AZ"}],"key":"EFTraU5D6U"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/LifeExpectancy//build/country_intercepts_l-91eee2f55729a9a344decc037835e37a.png","alt":"Country intercepts (random effects): deviation from grand mean, 94% credible intervals.","width":"80%","data":{"altTextIsAutoGenerated":true},"key":"ecmOO5Bp6x","urlSource":"figs/country_intercepts_le_intercepts.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"children":[{"type":"text","value":"Country intercepts (random effects): deviation from grand mean, 94% credible intervals.","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"CRSLkFPULP"}],"key":"CogKzY4IUw"}],"key":"IccKMJNhlY"}],"enumerator":"2","key":"eEKfB0Khv2"},{"type":"paragraph","position":{"start":{"line":149,"column":1},"end":{"line":150,"column":1}},"children":[{"type":"text","value":"Most of the intercepts are smaller than 0.5 years, positive or negative, and only a few are larger than one year.\nIn Estonia, Latvia, and South Korea, life expectancy gaps are larger than the model would predict based on cause-specific death rates alone; in Mexico it is smaller than predicted.","position":{"start":{"line":149,"column":1},"end":{"line":149,"column":1}},"key":"hrZVGgzPOA"}],"key":"eoF78kFZR7"},{"type":"paragraph","position":{"start":{"line":152,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"These intercepts might reflect additional factors that are not included in the model, or interactions among the factors.\nThey could also reflect persistent biases in data reporting.","position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"key":"Jm4ahFsgVT"}],"key":"Rf4u4qpIaD"},{"type":"thematicBreak","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"key":"vLW11KNUx5"},{"type":"paragraph","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"children":[{"type":"text","value":"Next: [Healthy life expectancy: quality, not just quantity]","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"key":"cilH50eusE"}],"key":"q9cnhoyaO5"}],"key":"bZF3f49kHT"}],"key":"ERgw0yhcz8"}],"key":"aTggtx4ynZ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"How Much of the Life Expectancy Gap Could We Close?","short_title":"Blog Post 3: Counterfactuals","url":"/blog3-counterfactual","group":"Gender Gaps in Life Expectancy"}}},"domain":"http://localhost:3026"}